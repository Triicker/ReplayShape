# Copie para .env e ajuste. NUNCA versione o .env.

# --- Ambiente ---------------------------------------------------------------
# development | production
RS_ENV=development
# em produção: false (obrigatório)
RS_DEMO_MODE=true
# domínio público (usado em QR Codes e webhooks)
RS_PUBLIC_BASE_URL=http://localhost:8000
# em produção (HTTPS): true (obrigatório)
RS_COOKIE_SECURE=false
# Chave mestra (sessões, criptografia de senhas de câmera). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fora de produção, se vazia, é gerada em data/secret.key.
RS_SECRET_KEY=
RS_DATA_DIR=./data

# --- Primeiro administrador (obrigatório em produção) -------------------------
RS_ADMIN_EMAIL=
RS_ADMIN_PASSWORD=

# --- Edge / vídeo -------------------------------------------------------------
RS_EDGE_ENABLED=true
RS_SEGMENT_SECONDS=2
RS_PROCESSING_WORKERS=2
# mantenha false: câmeras só na rede local
RS_ALLOW_PUBLIC_CAMERA_HOSTS=false
# RS_FFMPEG_BIN=/usr/bin/ffmpeg
# RS_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- Pagamentos -----------------------------------------------------------------
# mock (somente demo) | mercadopago
RS_PAYMENT_PROVIDER=mock
# use credenciais de TESTE primeiro
RS_MP_ACCESS_TOKEN=
# "assinatura secreta" do painel de webhooks do MP
RS_MP_WEBHOOK_SECRET=
# e-mail genérico do pagador (Pix exige payer.email)
RS_MP_PAYER_EMAIL=

# --- Armazenamento remoto (opcional) ---------------------------------------------
# local | s3 (Cloudflare R2 ou S3-compatível)
RS_STORAGE_BACKEND=local
# ex.: https://<account_id>.r2.cloudflarestorage.com
RS_S3_ENDPOINT=
RS_S3_REGION=auto
RS_S3_BUCKET=
RS_S3_ACCESS_KEY=
RS_S3_SECRET_KEY=
